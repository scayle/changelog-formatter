{
  "name": "@scayle/changelog-formatter",
  "version": "1.0.1",
  "description": "A custom formatter for creating changelogs with changesets",
  "private": true,
  "author": "SCAYLE Commerce Engine",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "./dist/index.mjs"
  ],
  "scripts": {
    "build": "unbuild",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "lint": "eslint .",
    "lint:ci": "eslint . --format gitlab",
    "lint:fix": "eslint . --fix",
    "verify-packaging": "attw --pack .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@changesets/types": "6.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.0",
    "@changesets/types": "6.1.0",
    "@scayle/eslint-config-storefront": "4.5.1",
    "dprint": "0.49.1",
    "eslint": "9.26.0",
    "eslint-formatter-gitlab": "6.0.0",
    "typescript": "5.8.3",
    "unbuild": "3.5.0"
  },
  "volta": {
    "node": "22.15.0"
  }
}
