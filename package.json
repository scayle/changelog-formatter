{
  "name": "@scayle/changelog-formatter",
  "version": "1.1.2",
  "description": "A custom formatter for creating changelogs with changesets",
  "author": "SCAYLE Commerce Engine",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "./dist/index.mjs"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "build": "unbuild",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "lint": "eslint .",
    "lint:ci": "eslint . --format gitlab",
    "lint:fix": "eslint . --fix",
    "verify-packaging": "attw --pack .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@changesets/types": "6.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/types": "6.1.0",
    "@scayle/eslint-config-storefront": "workspace:*",
    "dprint": "catalog:",
    "eslint": "catalog:",
    "eslint-formatter-gitlab": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  }
}
